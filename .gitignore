# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Added by cargo

/target

# Dependencies fetched by `cargo xtask vendor fetch` (pinned in vendor.lock)
/vendor/

# What a failing snapshot test leaves beside the stored image
crates/gossia-app/tests/snapshots/**/*.new.png
crates/gossia-app/tests/snapshots/**/*.diff.png
crates/gossia-app/tests/snapshots/**/*.old.png

# What makepkg leaves beside the PKGBUILD (packaging/linux/build-package.sh arch)
packaging/linux/arch/src/
packaging/linux/arch/pkg/
packaging/linux/arch/*.pkg.tar.zst

# The VS Code extension: its Node.js packages, and the wasm module copied in
# by cargo xtask vscode.
/vscode/node_modules/
/vscode/media/pkg/
