{
  "name": "gossia",
  "displayName": "Gossia",
  "description": "%description%",
  "version": "0.7.0",
  "publisher": "wvdveer",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wvdveer/gossia"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onFileSystem:gossia"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "gossia.workbook",
        "displayName": "%customEditor.workbook%",
        "selector": [
          {
            "filenamePattern": "*.gossia"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "gossia.newTab",
        "title": "%command.newTab%",
        "category": "Gossia"
      },
      {
        "command": "gossia.saveShare",
        "title": "%command.saveShare%",
        "category": "Gossia"
      },
      {
        "command": "gossia.import",
        "title": "%command.import%",
        "category": "Gossia"
      },
      {
        "command": "gossia.export",
        "title": "%command.export%",
        "category": "Gossia"
      },
      {
        "command": "gossia.exportPdf",
        "title": "%command.exportPdf%",
        "category": "Gossia"
      },
      {
        "command": "gossia.exportHtml",
        "title": "%command.exportHtml%",
        "category": "Gossia"
      },
      {
        "command": "gossia.undo",
        "title": "%command.undo%",
        "category": "Gossia"
      },
      {
        "command": "gossia.redo",
        "title": "%command.redo%",
        "category": "Gossia"
      },
      {
        "command": "gossia.recalculate",
        "title": "%command.recalculate%",
        "category": "Gossia"
      },
      {
        "command": "gossia.codeEditor",
        "title": "%command.codeEditor%",
        "category": "Gossia"
      },
      {
        "command": "gossia.dataSources",
        "title": "%command.dataSources%",
        "category": "Gossia"
      },
      {
        "command": "gossia.disconnect",
        "title": "%command.disconnect%",
        "category": "Gossia"
      },
      {
        "command": "gossia.options",
        "title": "%command.options%",
        "category": "Gossia"
      },
      {
        "command": "gossia.toolbar",
        "title": "%command.toolbar%",
        "category": "Gossia"
      },
      {
        "command": "gossia.issues",
        "title": "%command.issues%",
        "category": "Gossia"
      },
      {
        "command": "gossia.inspector",
        "title": "%command.inspector%",
        "category": "Gossia"
      },
      {
        "command": "gossia.openModule",
        "title": "%command.openModule%",
        "category": "Gossia"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gossia.newTab",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.saveShare",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.import",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.export",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.exportPdf",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.exportHtml",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.undo",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.redo",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.recalculate",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.codeEditor",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.dataSources",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.disconnect",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.options",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.toolbar",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.issues",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.inspector",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        },
        {
          "command": "gossia.openModule",
          "when": "activeCustomEditorId == gossia.workbook || resourceScheme == gossia"
        }
      ]
    }
  }
}
