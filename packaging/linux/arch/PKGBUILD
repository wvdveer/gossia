# The Arch package of Gossia, built from this checkout (no sources are
# downloaded) by packaging/linux/build-package.sh arch, which gives the
# version in GOSSIA_VERSION.
pkgname=gossia
pkgver=${GOSSIA_VERSION:?run this through packaging/linux/build-package.sh arch}
pkgrel=1
pkgdesc="Workbooks of JSON and XML with Python formulas, forms and reports"
arch=(x86_64)
url="https://github.com/wvdveer/gossia"
license=(Apache-2.0)
# OpenGL, X11 and Wayland are loaded while running, not linked.
depends=(gcc-libs glibc openssl fontconfig libglvnd libxkbcommon wayland libx11 libxcursor libxrandr libxi)
# Cargo comes from rustup (rust-toolchain.toml pins the toolchain).
makedepends=()
# Rust does its own optimisation; makepkg's LTO flags and debug package do not
# suit it.
options=(!lto !debug)

_root=$(realpath "$startdir/../../..")

build() {
  cd "$_root"
  cargo build --release --locked -p gossia-app -p gossia-cli --bin gossia --bin bidwillii
  cargo xtask icons target/release/icons
}

package() {
  cd "$_root"
  install -Dm755 target/release/gossia "$pkgdir/usr/bin/gossia"
  install -Dm755 target/release/bidwillii "$pkgdir/usr/bin/bidwillii"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/linux/gossia.desktop "$pkgdir/usr/share/applications/gossia.desktop"
  install -Dm644 packaging/linux/gossia.xml "$pkgdir/usr/share/mime/packages/gossia.xml"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "target/release/icons/$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/gossia.png"
  done
}
