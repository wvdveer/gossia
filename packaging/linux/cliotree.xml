<?xml version="1.0" encoding="UTF-8"?>
<!-- The MIME type of ClioTree workbooks, for shared-mime-info: a .clio file
     is a zip archive, told apart by its extension. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-cliotree-workbook">
    <comment>ClioTree workbook</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.clio"/>
    <icon name="cliotree"/>
  </mime-type>
</mime-info>
